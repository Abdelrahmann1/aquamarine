# The dashboard is private. Keep it out of search engines, and refuse
# direct requests for the files that exist only to be included.

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>

<FilesMatch "^(config\.php|config\.sample\.php|lib\.php|head\.php|foot\.php|schema\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "\.(sql|log|md|bak|inc|json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# No directory listing if an index is ever missing.
Options -Indexes
